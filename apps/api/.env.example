// Database
DATABASE_URL="postgresql://postgres@localhost:55432/crm_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres@localhost:55432/crm_test?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres@localhost:55432/crm_shadow?schema=public"

// App
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

// Auth (сгенерируйте свои значения: openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
