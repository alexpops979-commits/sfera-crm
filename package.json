{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "description": "Сфера CRM — multi-tenant CRM для малого бизнеса",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run build:shared",
    "dev": "concurrently -k -n shared,api,web -c yellow,blue,green \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace @crm/shared",
    "dev:api": "npm run start:dev --workspace @crm/api",
    "dev:web": "npm run dev --workspace @crm/web",
    "build": "npm run build:shared && npm run build --workspace @crm/api && npm run build --workspace @crm/web",
    "build:shared": "npm run build --workspace @crm/shared",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @crm/api",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 status",
    "db:migrate": "npm run db:migrate --workspace @crm/api",
    "db:seed": "npm run db:seed --workspace @crm/api",
    "db:studio": "npm run db:studio --workspace @crm/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
